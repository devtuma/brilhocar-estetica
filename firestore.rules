rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== USERS ======
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // nunca deletar users

      // Sub-coleção de carros
      match /cars/{carId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ====== EMAIL LOGINS (vinculação email -> uid) ======
    match /emailLogins/{email} {
      // Apenas o próprio user pode ler seu registro (não permite enumeração)
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false; // imutável
    }

    // ====== APPOINTMENTS ======
    match /appointments/{appointmentId} {
      // Qualquer usuário logado pode criar seu próprio appointment
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // SEGURANÇA: Ler apenas o próprio agendamento ou admin
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        ('admin' in request.auth.token) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      // Update: apenas o dono pode atualizar seus campos PIX OU admin
      allow update: if request.auth != null && (
        (resource.data.userId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['pixStatus', 'updatedAt'])) ||
        ('admin' in request.auth.token) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      // Delete: apenas admin
      allow delete: if request.auth != null && (
        ('admin' in request.auth.token) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ====== CONFIG (CMS) ======
    match /config/{document=**} {
      // Textos públicos podem ser lidos por todos
      allow read: if true;
      // Escrita: apenas admin (verificado via custom claim ou collection admins)
      // Fallback: usuário autenticado (TODO: migrar para isAdmin() com custom claim)
      allow write: if request.auth != null && (
        // Admin por custom claim
        ('admin' in request.auth.token) ||
        // Admin por documento na coleção admins
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ====== ADMINS (allowlist) ======
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // apenas via deploy manual / Cloud Function
    }

    // ====== ANALYTICS ======
    match /analytics/{docId} {
      allow read: if false; // só admin
      allow create: if true; // qualquer usuário pode criar eventos
      allow update, delete: if false;
    }

    // ====== TRANSACTIONS (PIX) ======
    match /transactions/{transactionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // só via Functions/webhook
    }

    // ====== PROMOTIONS ======
    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if false; // via Functions ou admin
    }

    // ====== TIME SLOTS (Agenda) ======
    match /timeSlots/{slotId} {
      allow read: if true; // todos veem horários disponíveis
      allow write: if false; // só admin via Functions
    }

    // ====== SERVICES ======
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false; // via Functions ou admin
    }

    // ====== TESTIMONIALS ======
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if false; // via Functions ou admin
    }

    // ====== IMAGES ======
    match /images/{imageId} {
      allow read: if true;
      allow write: if false; // via Functions ou admin
    }

    // ====== SETTINGS ======
    match /settings/{document} {
      allow read: if true;
      allow write: if false; // via Functions ou admin
    }

    // ====== AUDIT LOGS ======
    match /audit_logs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // ====== CLIENTS (legacy - migrar para users) ======
    match /clients/{clientId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
