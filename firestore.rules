rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== USERS ======
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // nunca deletar users

      // Sub-coleção de carros
      match /cars/{carId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ====== EMAIL LOGINS (vinculação email -> uid) ======
    match /emailLogins/{email} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false; // imutável
    }

    // ====== APPOINTMENTS ======
    match /appointments/{appointmentId} {
      // Qualquer usuário logado pode criar
      allow create: if request.auth != null;
      // Ler: próprio usuário ou admin
      allow read: if request.auth != null;
      // Update/Delete: via Functions ou webhook do Asaas (admin)
      allow update, delete: if false;
    }

    // ====== CONFIG (CMS) ======
    match /config/{document=**} {
      // Textos públicos podem ser lidos por todos
      allow read: if true;
      // Escrita: só via Functions (admin)
      allow write: if false;
    }

    // ====== ANALYTICS ======
    match /analytics/{docId} {
      allow read: if false; // só admin
      allow create: if true; // qualquer usuário pode criar eventos
      allow update, delete: if false;
    }

    // ====== TRANSACTIONS (PIX) ======
    match /transactions/{transactionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false; // só via Functions/webhook
    }

    // ====== PROMOTIONS ======
    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if false; // via Functions ou admin
    }

    // ====== TIME SLOTS (Agenda) ======
    match /timeSlots/{slotId} {
      allow read: if true; // todos veem horários disponíveis
      allow write: if false; // só admin via Functions
    }

    // ====== SERVICES ======
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false; // via Functions ou admin
    }

    // ====== TESTIMONIALS ======
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if false; // via Functions ou admin
    }

    // ====== IMAGES ======
    match /images/{imageId} {
      allow read: if true;
      allow write: if false; // via Functions ou admin
    }

    // ====== SETTINGS ======
    match /settings/{document} {
      allow read: if true;
      allow write: if false; // via Functions ou admin
    }

    // ====== AUDIT LOGS ======
    match /audit_logs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // ====== CLIENTS (legacy - migrar para users) ======
    match /clients/{clientId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
